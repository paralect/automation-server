# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Not used by the webhook endpoint; only affects the browser-facing oRPC routes.
# @optional @public @type=url
CORS_ORIGIN=

# HTTP port the server listens on.
# @public @type=port
PORT=3000

# Path of the sqlite file that stores processed-event claims, run history and logs. Mount it on a persistent volume.
# @public
DATABASE_PATH=./data/automation.db

# Bearer token for the admin API (activity dashboard). Use at least 32 random characters. The admin API is disabled when empty.
# @optional @sensitive
ADMIN_API_TOKEN=

# Days to keep stored logs and finished runs before they are pruned.
# @public @type=number(min=1)
LOG_RETENTION_DAYS=30

# Client Secret of the Sentry internal integration; used to verify webhook signatures. Can also be set in the admin.
# @optional @sensitive
SENTRY_CLIENT_SECRET=

# Optional Sentry auth token (Issue & Event: Read). Enables issue stats enrichment.
# @optional @sensitive
SENTRY_AUTH_TOKEN=

# @public @type=url
SENTRY_API_BASE_URL=https://sentry.io

# Comma-separated Sentry levels that create a GitHub issue.
# @public
SENTRY_LEVELS=error,fatal

# Comma-separated Sentry environments to handle. Empty means all.
# @optional @public
SENTRY_ENVIRONMENTS=

# Minimum issue event count. Only applied when the count is known (needs SENTRY_AUTH_TOKEN).
# @public @type=number(min=0)
SENTRY_MIN_EVENT_COUNT=1

# GitHub token with Issues: Read and write on the target repository. Can also be set in the admin.
# @optional @sensitive
GITHUB_TOKEN=

# Target repository as owner/name. Can also be set in the admin.
# @optional @public @type=string(matches=regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"))
GITHUB_REPO=

# Comma-separated owner/name repositories whose GitHub Actions runs the admin shows. Empty means GITHUB_REPO. GITHUB_TOKEN needs Actions: Read on each.
# @optional @public
GITHUB_ACTIONS_REPOS=

# Key that encrypts secrets saved from the admin (AES-256-GCM). Use at least 32 random characters and keep it stable: changing it makes saved secrets unreadable. Saving secrets from the admin is refused while empty.
# @optional @sensitive
SETTINGS_ENCRYPTION_KEY=

# Public base URL of this server (for example https://hooks.example.com). Used only to show full webhook URLs in the admin.
# @optional @public @type=url
PUBLIC_URL=

# Public base URL of the admin (for example https://admin.example.com). Lets Slack failure alerts link to the run page.
# @optional @public @type=url
ADMIN_PUBLIC_URL=

# Incoming webhook URL of the Slack channel that receives failure and token-health alerts. Must start with https://. Can also be set in the admin.
# @optional @sensitive
SLACK_ALERTS_WEBHOOK_URL=

# Bot User OAuth Token (xoxb-...) of the Slack app for the Slack bot. Can also be set in the admin.
# @optional @sensitive
SLACK_BOT_TOKEN=

# Signing Secret of the Slack app. Verifies that bot events come from Slack. Can also be set in the admin.
# @optional @sensitive
SLACK_SIGNING_SECRET=
