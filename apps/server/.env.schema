# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Not used by the webhook endpoint; only affects the browser-facing oRPC routes.
# @optional @public @type=url
CORS_ORIGIN=

# HTTP port the server listens on.
# @public @type=port
PORT=3000

# Path of the sqlite file that stores processed-event claims. Mount it on a persistent volume.
# @public
DATABASE_PATH=./data/automation.db

# Client Secret of the Sentry internal integration; used to verify webhook signatures.
# @sensitive
SENTRY_CLIENT_SECRET=

# Optional Sentry auth token (Issue & Event: Read). Enables issue stats enrichment.
# @optional @sensitive
SENTRY_AUTH_TOKEN=

# @public @type=url
SENTRY_API_BASE_URL=https://sentry.io

# Comma-separated Sentry levels that create a GitHub issue.
# @public
SENTRY_LEVELS=error,fatal

# Comma-separated Sentry environments to handle. Empty means all.
# @optional @public
SENTRY_ENVIRONMENTS=

# Minimum issue event count. Only applied when the count is known (needs SENTRY_AUTH_TOKEN).
# @public @type=number(min=0)
SENTRY_MIN_EVENT_COUNT=1

# GitHub token with Issues: Read and write on the target repository.
# @sensitive
GITHUB_TOKEN=

# Target repository as owner/name.
# @public @type=string(matches=regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"))
GITHUB_REPO=
