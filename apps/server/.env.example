# Copy to .env.local and fill in. Placeholders only.
PORT=3000
DATABASE_PATH=./data/automation.db

# Optional here: can be saved from the admin instead.
SENTRY_CLIENT_SECRET=replace-with-sentry-client-secret
GITHUB_TOKEN=replace-with-github-token
GITHUB_REPO=your-org/your-repo

# Optional
# SETTINGS_ENCRYPTION_KEY=
# PUBLIC_URL=https://hooks.example.com
# ADMIN_PUBLIC_URL=https://admin.example.com
# ADMIN_API_TOKEN=
# LOG_RETENTION_DAYS=30
# SENTRY_AUTH_TOKEN=
# SENTRY_API_BASE_URL=https://sentry.io
# SENTRY_LEVELS=error,fatal
# SENTRY_ENVIRONMENTS=production
# SENTRY_MIN_EVENT_COUNT=1
# GITHUB_ACTIONS_REPOS=your-org/your-repo,your-org/marketing-site
# SLACK_ALERTS_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# CORS_ORIGIN=http://localhost:5173
