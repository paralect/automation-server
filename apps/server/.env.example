# Copy to .env.local and fill in. Placeholders only.
PORT=3000
DATABASE_PATH=./data/automation.db

SENTRY_CLIENT_SECRET=replace-with-sentry-client-secret
GITHUB_TOKEN=replace-with-github-token
GITHUB_REPO=your-org/your-repo

# Optional
# SENTRY_AUTH_TOKEN=
# SENTRY_API_BASE_URL=https://sentry.io
# SENTRY_LEVELS=error,fatal
# SENTRY_ENVIRONMENTS=production
# SENTRY_MIN_EVENT_COUNT=1
# CORS_ORIGIN=http://localhost:5173
