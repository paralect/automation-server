# Where the automation server listens (the admin calls its /rpc endpoint).
AUTOMATION_SERVER_URL=http://localhost:3000
# Must equal the automation server's ADMIN_API_TOKEN. Never sent to the browser.
ADMIN_API_TOKEN=
# The single admin login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Encrypts the session cookie. At least 32 characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
