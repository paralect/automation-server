# Settings for docker compose. Copy to .env next to docker-compose.yml.
# Generate secrets with `openssl rand -base64 48`.

# Which compose files to use. The first builds the image on this machine, docker-compose.ghcr.yml
# pulls the one CI publishes. Append :docker-compose.traefik.yml for HTTPS (needs the domains below).
# COMPOSE_FILE=docker-compose.yml
# COMPOSE_FILE=docker-compose.ghcr.yml
# COMPOSE_FILE=docker-compose.ghcr.yml:docker-compose.traefik.yml

# With docker-compose.ghcr.yml: the image, and its tag (`latest`, or `sha-<commit>` to pin or roll back).
# IMAGE=ghcr.io/your-org/automation-server
# IMAGE_TAG=latest

# Shared by the server and the admin. At least 32 random characters.
ADMIN_API_TOKEN=

# Server. SENTRY_CLIENT_SECRET, GITHUB_TOKEN and GITHUB_REPO can be left empty and set from the admin instead.
SENTRY_CLIENT_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-repo
# Encrypts secrets saved from the admin. Required to save secrets there. Keep it stable.
# SETTINGS_ENCRYPTION_KEY=
# PUBLIC_URL=https://hooks.example.com
# ADMIN_PUBLIC_URL=https://admin.example.com
# GITHUB_ACTIONS_REPOS=your-org/your-repo,your-org/marketing-site
# SENTRY_AUTH_TOKEN=
# SENTRY_LEVELS=error,fatal
# SENTRY_ENVIRONMENTS=production
# SENTRY_MIN_EVENT_COUNT=1
# LOG_RETENTION_DAYS=30
# SLACK_ALERTS_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# Admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# At least 32 characters.
SESSION_SECRET=

# Without Traefik: host ports. The admin binds to 127.0.0.1 only.
# SERVER_PORT=3000
# ADMIN_PORT=3001

# With Traefik: both domains need an A record pointing at this machine.
# SERVER_DOMAIN=hooks.example.com
# ADMIN_DOMAIN=admin.example.com
# ACME_EMAIL=ops@example.com
# Let's Encrypt staging while testing, to stay inside the rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
